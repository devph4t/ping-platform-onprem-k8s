# =============================================================================
# Ping Identity Platform 8.x on Docker Desktop Kubernetes — settings
# Copy to .env with:  bash src/scripts/init-env.sh   (fills random secrets)
# .env is git-ignored. Values: no spaces, no quotes, no '$'.
# =============================================================================

# --- Hostname / URLs ---------------------------------------------------------
FQDN=ping-local.test.bbl
# Cookie domain for AM (usually same as FQDN)
COOKIE_DOMAIN=ping-local.test.bbl
NAMESPACE=ping

# --- Kubernetes --------------------------------------------------------------
KUBE_CONTEXT=docker-desktop
# Hidden kind node container that receives images (docker save | ctr import)
KIND_NODE_CONTAINER=desktop-control-plane
STORAGE_CLASS=standard
# Gateway HTTP port (only redirects to HTTPS). Change it (e.g. 8081) if port 80 is taken on the
# PC — e.g. by Windows "System" pid 4 (HTTP.sys/IIS) — otherwise the gateway stays <pending>.
# HTTPS is always 443.
GATEWAY_HTTP_PORT=80

# --- Vendor zips (in assets/apps/) -------------------------------------------
DS_ZIP=DS-8.1.2.zip
AM_ZIP=AM-8.1.1.zip
IDM_ZIP=IDM-8.1.2.zip
UI_ZIP=PlatformUI-8.1.2.0813.zip

# --- Images ------------------------------------------------------------------
IMAGE_PREFIX=ping-local
DS_VERSION=8.1.2
AM_VERSION=8.1.1
IDM_VERSION=8.1.2
UI_VERSION=8.1.2.0813

# --- DS ----------------------------------------------------------------------
DS_ROOT_DN=uid=admin
DS_ROOT_PASSWORD=CHANGE_ME
DS_DEPLOYMENT_ID_PASSWORD=CHANGE_ME
# Filled by: bash src/scripts/ds-deployment-id.sh  (CA exported to .secrets/ds-ca.pem)
DS_DEPLOYMENT_ID=
# idm-repo profile domain -> base DN dc=openidm,dc=forgerock,dc=com (IDM repo.ds.json expects forgerock.com)
DS_IDM_REPO_DOMAIN=forgerock.com

# Service accounts created by DS setup profiles
AM_CONFIG_ADMIN_PASSWORD=CHANGE_ME
AM_CTS_ADMIN_PASSWORD=CHANGE_ME
AM_IDENTITY_STORE_ADMIN_PASSWORD=CHANGE_ME

# --- AM ----------------------------------------------------------------------
AM_ADMIN_PASSWORD=CHANGE_ME
AM_ENCRYPTION_KEY=CHANGE_ME

# --- IDM ---------------------------------------------------------------------
IDM_ADMIN_PASSWORD=CHANGE_ME

# --- OAuth2 clients (created in AM by the platform-config job) ----------------
IDM_PROVISIONING_CLIENT_SECRET=CHANGE_ME
IDM_RS_CLIENT_SECRET=CHANGE_ME
ADMIN_CLIENT_ID=idm-admin-ui
ENDUSER_CLIENT_ID=end-user-ui

# --- Resources (dev sizing; Docker has ~11.6 GB) -----------------------------
DS_MEMORY=2Gi
AM_MEMORY=2560Mi
IDM_MEMORY=2Gi
UI_MEMORY=128Mi
